# Minimal Kconfig for the {{ profile.name }} profile.
# See KCONFIG_NOTES.md for why each symbol is required.
{% for req in kconfigs %}
{% if req.mandatory %}
{{ req.symbol }}={{ req.value }}
{% else %}
# (advisory) {{ req.symbol }}={{ req.value }} — {{ req.reason }}
{% endif %}
{% endfor %}
CONFIG_LOG=y
CONFIG_BT_DEVICE_APPEARANCE=0
