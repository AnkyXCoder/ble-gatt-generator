<!DOCTYPE html>
<!-- Auto-generated by ble-gatt-generator; do not edit. -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ profile.name }} Web Bluetooth Client</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; max-width: 60rem; }
    h1 { font-size: 1.4rem; }
    h2 { font-size: 1.1rem; margin-top: 2rem; }
    h3 { font-size: 1rem; margin: 0 0 0.5rem; }
    #log { background: #f5f5f5; border: 1px solid #ccc; padding: 1rem; height: 12rem; overflow: auto; font-size: 0.85rem; }
    .char { margin: 0.75rem 0; padding: 0.75rem 1rem; border: 1px solid #ddd; border-radius: 4px; }
    .props { color: #666; font-size: 0.8rem; }
    button { margin-right: 0.5rem; }
    button:disabled { opacity: 0.5; }
    input[type=text] { width: 20rem; font-family: monospace; }
  </style>
</head>
<body>
  <h1>{{ profile.name }} Web Bluetooth Client</h1>
  <p>
    <button id="connect">Connect</button>
    <button id="disconnect" disabled>Disconnect</button>
    <span id="status">Not connected</span>
  </p>
  <pre id="log"></pre>
  <div id="controls"></div>

  <script>
    const DEVICE_NAME_PREFIX = "GATT Gen";
    const SERVICES = [
      {% for svc in profile.services %}
      {
        name: "{{ svc.name }}",
        uuid: "{{ svc.uuid | client_uuid }}",
        characteristics: [
          {% for chrc in svc.characteristics %}
          {
            name: "{{ chrc.name }}",
            uuid: "{{ chrc.uuid | client_uuid }}",
            properties: {{ chrc.properties | tojson }},
            size: {{ chrc.size }}
          },
          {% endfor %}
        ]
      },
      {% endfor %}
    ];

    const logEl = document.getElementById('log');
    const statusEl = document.getElementById('status');
    const connectBtn = document.getElementById('connect');
    const disconnectBtn = document.getElementById('disconnect');
    let device = null;
    let server = null;
    const charCache = new Map();

    function log(msg) {
      logEl.textContent += `[${new Date().toLocaleTimeString()}] ${msg}\n`;
      logEl.scrollTop = logEl.scrollHeight;
    }

    function hex(dataView) {
      return Array.from(new Uint8Array(dataView.buffer))
        .map(b => b.toString(16).padStart(2, '0')).join(' ');
    }

    function parseHex(text) {
      const clean = text.replace(/[^0-9a-fA-F]/g, '');
      if (clean.length % 2) throw new Error('odd number of hex digits');
      return Uint8Array.from(clean.match(/../g) || [], h => parseInt(h, 16));
    }

    function setConnected(on) {
      connectBtn.disabled = on;
      disconnectBtn.disabled = !on;
      document.querySelectorAll('.char button').forEach(b => b.disabled = !on);
      statusEl.textContent = on ? `Connected to ${device.name || device.id}` : 'Not connected';
    }

    async function getChar(serviceUuid, charUuid) {
      const key = serviceUuid + '/' + charUuid;
      if (!charCache.has(key)) {
        const service = await server.getPrimaryService(serviceUuid);
        charCache.set(key, await service.getCharacteristic(charUuid));
      }
      return charCache.get(key);
    }

    connectBtn.addEventListener('click', async () => {
      try {
        device = await navigator.bluetooth.requestDevice({
          filters: [{ namePrefix: DEVICE_NAME_PREFIX }],
          optionalServices: SERVICES.map(s => s.uuid)
        });
        device.addEventListener('gattserverdisconnected', () => {
          log('Disconnected');
          charCache.clear();
          setConnected(false);
        });
        server = await device.gatt.connect();
        log(`Connected to ${device.name || device.id}`);
        setConnected(true);
      } catch (e) {
        log('Connect error: ' + e);
      }
    });

    disconnectBtn.addEventListener('click', () => device && device.gatt.disconnect());

    function buildControls() {
      const root = document.getElementById('controls');
      for (const svc of SERVICES) {
        const h2 = document.createElement('h2');
        h2.textContent = `${svc.name} (${svc.uuid})`;
        root.appendChild(h2);

        for (const c of svc.characteristics) {
          const div = document.createElement('div');
          div.className = 'char';
          div.innerHTML = `<h3>${c.name}</h3>
            <div class="props">${c.uuid} — ${c.properties.join(', ')} — ${c.size} byte(s)</div>`;

          if (c.properties.includes('read')) {
            const b = document.createElement('button');
            b.textContent = 'Read';
            b.disabled = true;
            b.onclick = async () => {
              try {
                const ch = await getChar(svc.uuid, c.uuid);
                log(`${c.name} read: ${hex(await ch.readValue())}`);
              } catch (e) { log(`${c.name} read error: ${e}`); }
            };
            div.appendChild(b);
          }

          if (c.properties.includes('write') || c.properties.includes('write_without_response')) {
            const input = document.createElement('input');
            input.type = 'text';
            input.placeholder = 'hex bytes, e.g. 01 02 ff';
            input.value = Array.from({ length: c.size }, (_, i) => (i % 256).toString(16).padStart(2, '0')).join(' ');
            const b = document.createElement('button');
            b.textContent = 'Write';
            b.disabled = true;
            b.onclick = async () => {
              try {
                const ch = await getChar(svc.uuid, c.uuid);
                const bytes = parseHex(input.value);
                if (c.properties.includes('write')) {
                  await ch.writeValueWithResponse(bytes);
                } else {
                  await ch.writeValueWithoutResponse(bytes);
                }
                log(`${c.name} wrote: ${hex(new DataView(bytes.buffer))}`);
              } catch (e) { log(`${c.name} write error: ${e}`); }
            };
            div.appendChild(input);
            div.appendChild(b);
          }

          if (c.properties.includes('notify') || c.properties.includes('indicate')) {
            const b = document.createElement('button');
            b.textContent = 'Subscribe';
            b.disabled = true;
            let subscribed = false;
            const handler = (ev) => log(`${c.name} <- ${hex(ev.target.value)}`);
            b.onclick = async () => {
              try {
                const ch = await getChar(svc.uuid, c.uuid);
                if (subscribed) {
                  await ch.stopNotifications();
                  ch.removeEventListener('characteristicvaluechanged', handler);
                  b.textContent = 'Subscribe';
                  log(`${c.name} unsubscribed`);
                } else {
                  ch.addEventListener('characteristicvaluechanged', handler);
                  await ch.startNotifications();
                  b.textContent = 'Unsubscribe';
                  log(`${c.name} subscribed`);
                }
                subscribed = !subscribed;
              } catch (e) { log(`${c.name} subscribe error: ${e}`); }
            };
            div.appendChild(b);
          }

          root.appendChild(div);
        }
      }
    }

    if (!navigator.bluetooth) {
      log('Web Bluetooth is not available in this browser. Use Chrome/Edge over HTTPS or localhost.');
      connectBtn.disabled = true;
    }
    buildControls();
  </script>
</body>
</html>
