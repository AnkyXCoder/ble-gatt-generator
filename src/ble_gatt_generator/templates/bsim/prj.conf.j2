# BabbleSim self-test: one binary plays both the peripheral running the
# generated GATT services and the central that verifies them.
CONFIG_BT=y
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_CENTRAL=y
CONFIG_BT_OBSERVER=y
CONFIG_BT_GATT_CLIENT=y
CONFIG_BT_GATT_AUTO_DISCOVER_CCC=y
CONFIG_BT_DEVICE_NAME="GATT Gen {{ profile.name }}"
{% if profile.needs_smp() %}
# Some characteristics require encryption/authentication.
CONFIG_BT_SMP=y
{% endif %}
CONFIG_ASSERT=y
CONFIG_LOG=y
