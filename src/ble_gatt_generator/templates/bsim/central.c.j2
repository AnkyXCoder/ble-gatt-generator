static void test_central(void)
{
	int err;

	err = bk_sync_init();
	if (err) {
		TEST_FAIL("Backchannel init failed (err %d)", err);
	}

	err = bt_enable(NULL);
	if (err != 0) {
		TEST_FAIL("Bluetooth init failed (err %d)", err);
	}

	err = bt_le_scan_start(BT_LE_SCAN_PASSIVE, device_found);
	if (err != 0) {
		TEST_FAIL("Scanning failed to start (err %d)", err);
	}

	printk("Scanning successfully started\n");

	WAIT_FOR_FLAG(flag_is_connected);

{% if profile.needs_smp() %}
	err = bt_conn_set_security(g_conn, {{ profile.required_security() }});
	if (err) {
		TEST_FAIL("Starting security procedure failed (%d)", err);
	}
	WAIT_FOR_FLAG(flag_is_encrypted);
	printk("Link encrypted\n");

{% endif %}
	/* Discover every generated characteristic by UUID. */
{% for svc in profile.services %}
{% for chrc in svc.characteristics %}
{% set base = svc.name ~ '_' ~ chrc.name %}
	uint16_t {{ base }}_handle = discover_chrc({{ svc.name | upper }}_{{ chrc.name | upper }}_UUID);
	if ({{ base }}_handle == 0) {
		TEST_FAIL("{{ svc.name }}/{{ chrc.name }} not found");
	}
	printk("{{ svc.name }}/{{ chrc.name }}: value handle %u\n", {{ base }}_handle);
{% endfor %}
{% endfor %}

	/* Verify readable characteristics return their full value size. */
{% for svc in profile.services %}
{% for chrc in svc.characteristics if chrc.has_read() %}
	{
		uint16_t len = read_chrc({{ svc.name }}_{{ chrc.name }}_handle);

		if (len != {{ svc.name | upper }}_{{ chrc.name | upper }}_SIZE) {
			TEST_FAIL("{{ svc.name }}/{{ chrc.name }} read len %u, expected %u",
				  len, {{ svc.name | upper }}_{{ chrc.name | upper }}_SIZE);
		}
	}
{% endfor %}
{% endfor %}

	/* Exercise writable characteristics; verify by read-back when possible. */
{% for svc in profile.services %}
{% for chrc in svc.characteristics if chrc.has_write() %}
	{
		uint8_t pattern[{{ svc.name | upper }}_{{ chrc.name | upper }}_SIZE];

		for (size_t i = 0; i < sizeof(pattern); i++) {
			pattern[i] = (uint8_t)(0xa5 ^ i);
		}

{% if 'write' in chrc.properties %}
		write_chrc({{ svc.name }}_{{ chrc.name }}_handle, pattern, sizeof(pattern));
{% else %}
		err = bt_gatt_write_without_response(g_conn, {{ svc.name }}_{{ chrc.name }}_handle,
						     pattern, sizeof(pattern), false);
		if (err < 0) {
			TEST_FAIL("{{ svc.name }}/{{ chrc.name }} write failed (err %d)", err);
		}
		/* Write without response is queued; give it time to land. */
		k_sleep(K_MSEC(100));
{% endif %}
{% if chrc.has_read() %}
		{
			uint16_t len = read_chrc({{ svc.name }}_{{ chrc.name }}_handle);

			if (len != sizeof(pattern) ||
			    memcmp(read_buf, pattern, sizeof(pattern)) != 0) {
				TEST_FAIL("{{ svc.name }}/{{ chrc.name }} read-back mismatch");
			}
		}
{% endif %}
	}
{% endfor %}
{% endfor %}

	/* Subscribe to every notification/indication source. */
{% for svc in profile.services %}
{% for chrc in svc.characteristics if chrc.needs_ccc() %}
{% set base = svc.name ~ '_' ~ chrc.name %}
	{{ base }}_sub.value_handle = {{ base }}_handle;
	err = bt_gatt_subscribe(g_conn, &{{ base }}_sub);
	if (err < 0) {
		TEST_FAIL("{{ svc.name }}/{{ chrc.name }} subscribe failed (err %d)", err);
	}
	WAIT_FOR_FLAG({{ base }}_subscribed);
{% endfor %}
{% endfor %}

	printk("All characteristics verified; signalling peripheral\n");

	/* Tell the peripheral to start pushing values. */
	bk_sync_send();

{% if profile.any_ccc() %}
	/* Wait for the expected pushes. */
	for (int i = 0; i < WAIT_ITERS; i++) {
		if (
