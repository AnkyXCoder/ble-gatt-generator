{% for svc in profile.services %}
{% for chrc in svc.characteristics if chrc.needs_ccc() %}
	if ({{ svc.name }}_{{ chrc.name }}_received < {{ 1 if chrc.has_indicate() else 'NOTIFICATION_COUNT' }}) {
		TEST_FAIL("{{ svc.name }}/{{ chrc.name }}: got %u values, expected %u",
