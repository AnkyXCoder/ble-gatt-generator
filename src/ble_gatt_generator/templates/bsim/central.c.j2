{%- for chrc in svc.characteristics if chrc.needs_ccc() -%}
{% if not ns.first %} && {% endif %}{{ svc.name }}_{{ chrc.name }}_received >= {{ 1 if chrc.has_indicate() else 'NOTIFICATION_COUNT' }}
{%- set ns.first = false -%}
{%- endfor -%}
{%- endfor %} ) {
			break;
		}
		k_sleep(K_MSEC(10));
